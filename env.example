# Copy this file to .env and add your own keys. Never commit .env.
TAVILY_API_KEY=your_tavily_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
PORT=8765

# Invite-only preview security
INVITE_CODE=choose-a-long-random-invite-code
ADMIN_DASHBOARD_KEY=choose-a-different-long-admin-key
SESSION_SECRET=generate-a-random-secret-at-least-32-bytes
DAILY_ACTION_LIMIT=3
SESSION_HOURS=24
TRUST_PROXY_HEADERS=true
COOKIE_SECURE=true
HOST=0.0.0.0
# Railway supplies PORT automatically; 8765 is for local development.
IP_HASH_SECRET=another-long-random-secret-kept-stable
